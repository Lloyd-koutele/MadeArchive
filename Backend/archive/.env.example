# ─────────────────────────────────────────────────────────────────────────
# MadeArchive — modèle de configuration (.env)

# À CHANGER
APP_DOMAIN=votredomaine.com

# Optionnel — origines CORS de confiance supplémentaires (URLs COMPLÈTES,
# avec schéma, séparées par des virgules). Vide par défaut, sans effet.
# Utile pour tester l'application depuis un autre appareil du même réseau
# local (ex: téléphone) via l'IP du serveur plutôt que le domaine — ex:
# https://192.168.1.5:8443. Ne PAS utiliser pour un vrai second domaine de
# production (préférer alors une vraie entrée DNS + changer APP_DOMAIN
# ci-dessus, qui se propage tout seul à Traefik).
CORS_ADDITIONAL_ORIGINS=

# ── Let's Encrypt (certificat HTTPS automatique, via Traefik) ─────────────
# À CHANGER — email valide, requis par Let's Encrypt 
ACME_EMAIL=vous@votredomaine.com

# ── Admin initial — OPTIONNEL ──────────────────────────────────────────────

INITIAL_ADMIN_EMAIL=admin@votredomaine.com
INITIAL_ADMIN_PASSWORD=change-moi
INITIAL_ADMIN_NOM=Nom
INITIAL_ADMIN_PRENOM=Prenom
INITIAL_ADMIN_TELEPHONE=+221000000000

# ── Base de données (PostgreSQL, conteneurisé — voir docker-compose.yml) ──

DB_URL=jdbc:postgresql://localhost:5432/madearchive
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_MOI

# ── JWT (jetons de connexion) ──────────────────────────────────────────────
# À CHANGER — génération suggérée : openssl rand -base64 48
JWT_SECRET=CHANGE_MOI
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=28800000

# ── Stockage des documents (MinIO, conteneurisé) ───────────────────────────
STORAGE_PROVIDER=minio
# MINIO_URL : ne pas toucher pour un usage Docker (surchargée vers le
# service "minio") — utile seulement en usage natif hors Docker.
MINIO_URL=http://localhost:9000
# À CHANGER — identifiants du compte MinIO root (n'importe quelle valeur,
# choisie par vous, pas un compte tiers)
MINIO_ACCESS_KEY=CHANGE_MOI
MINIO_SECRET_KEY=CHANGE_MOI
MINIO_BUCKET=documents
MINIO_EXPIRY_HOURS=24

# ── Chromium (navigateur headless, import de dossiers Google Drive) ───────
# À CHANGER — jeton choisi par vous, protège l'accès au conteneur Chromium
# (pas un compte/service tiers) : openssl rand -hex 24
CHROMIUM_TOKEN=CHANGE_MOI

# ── Meilisearch (recherche plein texte, conteneurisé) ──────────────────────
# À CHANGER — génération suggérée : openssl rand -base64 32
MEILI_MASTER_KEY=CHANGE_MOI
# MEILISEARCH_HOST : ne pas toucher pour un usage Docker (surchargée vers
# le service "meilisearch").
MEILISEARCH_HOST=http://127.0.0.1:7700

# ── Ollama (génération assistée des règles d'extraction) ──────────────────
# Ne pas toucher pour un usage Docker (surchargée vers le service "ollama").
OLLAMA_BASE_URL=http://localhost:11434

# ── Tesseract (OCR) ─────────────────────────────────────────────────────
# Surchargée par docker-compose.yml pour Docker — cette valeur ne sert qu'à
# un usage natif hors Docker (chemin dépendant de l'OS/du gestionnaire de
# paquets local, ex. Homebrew sur Mac).
TESSERACT_DATA_PATH=/opt/homebrew/share/tessdata

# ── HSM fichier (clés privées de signature PKI des éditeurs) ──────────────
# Chemin du fichier — ne pas toucher pour un usage Docker (surchargé vers un
# volume nommé, /app/hsm/...).
HSM_KEYSTORE_PATH=./hsm/editors-keystore.p12
# À CHANGER — génération suggérée : openssl rand -base64 32
HSM_KEYSTORE_PASSWORD=CHANGE_MOI

# ── Chiffrement au repos des PDF/A archivés (AES-256-GCM) ──────────────────
# À CHANGER — DOIT faire exactement 32 octets une fois décodée en Base64 :
# openssl rand -base64 32
STORAGE_ENCRYPTION_KEY=CHANGE_MOI

